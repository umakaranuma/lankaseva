# Development environment — loaded when main.dart's kEnvironment = AppEnv.development
#
# Committed to git. These values are bundled into the app as an asset and are
# extractable from a release build — put URLs / public config here, NOT real
# secrets (server-only credentials must stay on the backend).

# Backend origin — NO trailing slash, NO /api suffix.
#   Android emulator      -> http://10.0.2.2:8000
#   iOS sim / desktop      -> http://127.0.0.1:8000
#   Physical phone (LAN)   -> http://192.168.8.56:8000   <-- this PC's Wi-Fi IP
API_BASE_URL=http://192.168.8.56:8000

# Extra per-environment values go here, e.g.:
# MAPS_API_KEY=
# SENTRY_DSN=
